# ===============================
# Server (required to run)
# ===============================
PORT=3000
FRONTEND_URL=http://localhost:4200

# ===============================
# Database (required)
# ===============================
# Local: mongodb://localhost:27017/mindmemos
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/mindmemos
MONGODB_URI=mongodb://localhost:27017/mindmemos

# ===============================
# Auth (required)
# ===============================
# Use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===============================
# Google – Gemini (required for AI chat/panic)
# ===============================
# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: default is gemini-2.0-flash. Other options: gemini-2.5-flash, gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash

# ===============================
# Google – Speech (required for STT/TTS)
# ===============================
# Path to service account JSON with Speech-to-Text + Text-to-Speech roles.
# On GCE you can omit this if the VM service account has those roles.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# ===============================
# Email (optional – for alerts)
# ===============================
# EMAIL_PROVIDER=gmail
# EMAIL_FROM=MindMemos Alerts <you@example.com>
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=app-password