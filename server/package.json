{
  "name": "mindmemos-server",
  "version": "1.0.0",
  "description": "MindMemos backend server - Node.js + Express + MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:ngrok": "ts-node-dev --respawn --transpile-only src/scripts/startWithNgrok.ts",
    "ngrok:url": "ts-node-dev --transpile-only src/scripts/getNgrokUrl.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed:rooms": "ts-node-dev --transpile-only src/scripts/seedChatRooms.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mindmemos",
    "mental-health",
    "journaling"
  ],
  "author": "Mehak Sharma",
  "license": "ISC",
  "dependencies": {
    "@azure/web-pubsub": "^1.2.0",
    "@azure/web-pubsub-express": "^1.0.6",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "socket.io": "^4.7.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.4",
    "ngrok": "^4.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
